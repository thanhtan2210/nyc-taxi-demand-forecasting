# Raw trip records are never stored in the repo; only the hourly mart is committed
*.parquet
!data/mart/**/*.parquet
!reports/*.parquet

# Local DuckDB warehouse (rebuilt by `python -m src.warehouse`)
warehouse/

# Wall-clock timings: they change on every run
reports/train_timings.json
reports/warehouse_timings.json

# Environments
.env
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# OS generated files
desktop.ini
.DS_Store
